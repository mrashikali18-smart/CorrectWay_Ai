# Copy this file to .env and fill in real values before running in production.

# Equivalent of the original server/.env.example's JWT_SECRET —
# Django uses this key to sign sessions, CSRF tokens, etc.
DJANGO_SECRET_KEY=change-this-to-a-long-random-string

# Equivalent of the original NODE_ENV / debug behavior.
DJANGO_DEBUG=True

# Comma-separated list of hosts allowed to serve this app.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Original server/.env.example also had MONGO_URI, PORT, and
# CLIENT_ORIGIN. Those are no longer needed:
#   - MONGO_URI      -> replaced by the DATABASES setting in
#                        correctway/settings.py (SQLite by default;
#                        swap in Postgres/MySQL there if needed)
#   - PORT           -> set via `python manage.py runserver <port>`
#   - CLIENT_ORIGIN  -> no longer needed; Django serves the frontend
#                        directly, so there's no separate origin to allow
